[
{"t": 16.3, "e": 20.61, "text": "何かを知ってしまったことで"},
{"t": 20.62, "e": 24.61, "text": "失うこともあるとは知るが"},
{"t": 24.62, "e": 28.46, "text": "光が生み出す創造だけは"},
{"t": 28.87, "e": 33.03, "text": "歩む孤独にあふれて"},
{"t": 33.04, "e": 37.21, "text": "今戦うのは何の為だ"},
{"t": 37.22, "e": 42.29, "text": "まだ見ぬ世界の為だろう"},
{"t": 42.3, "e": 47.16, "text": "どうせ全てが壊れるならば"},
{"t": 47.17, "e": 55.0, "text": "せめて自分だけはまともで居たいと思う"},
{"t": 55.01, "e": 60.9, "text": "誰も知らない存在 エハブミさん"},
{"t": 60.91, "e": 65.04, "text": "何かを知らずに進んだことを"},
{"t": 67.71, "e": 73.4, "text": "後悔する日もあるとは知るが"},
{"t": 73.41, "e": 79.36, "text": "闇が生み出す苦しみだけは"},
{"t": 80.42, "e": 86.01, "text": "人の優しさ身に染みて"},
{"t": 86.02, "e": 91.32, "text": "また戦うのは何の為だ"},
{"t": 92.29, "e": 97.02, "text": "命の希望の為だろう"},
{"t": 97.03, "e": 102.42, "text": "そして未来に届かなくても"},
{"t": 102.43, "e": 109.82, "text": "せめて自分だけはまともで居たいと思う"},
{"t": 109.83, "e": 116.19, "text": "特に褒められもしない エハブミさん"},
{"t": 128.88, "e": 134.98, "text": "やがて時代が生まれるならば"},
{"t": 134.99, "e": 143.19, "text": "ここは自分だけでもまともで居たいと思う"},
{"t": 144.93, "e": 154.05, "text": "何でこんな事になった エハブミさん"},
{"t": 154.06, "e": 159.19, "text": "いつか繋いだ花を墓標に\u0000"}
]
