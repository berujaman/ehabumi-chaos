[
{"t": 16.39, "e": 21.05, "text": "何かを知ってしまったことで"},
{"t": 21.05, "e": 28.42, "text": "失うこともあるとは知るが"},
{"t": 28.95, "e": 34.13, "text": "光が生み出す創造だけは"},
{"t": 34.13, "e": 41.0, "text": "歩む孤独にあふれて"},
{"t": 41.0, "e": 44.4, "text": "今戦うのは何の為だ"},
{"t": 44.4, "e": 50.04, "text": "まだ見ぬ世界の為だろう"},
{"t": 50.04, "e": 53.84, "text": "どうせ全てが壊れるならば"},
{"t": 53.84, "e": 58.3, "text": "せめて自分だけはまともで居たいと思う"},
{"t": 58.3, "e": 65.01, "text": "誰も知らない存在 エハブミさん"},
{"t": 67.76, "e": 72.64, "text": "何かを知らずに進んだことを"},
{"t": 72.64, "e": 79.26, "text": "後悔する日もあるとは知るが"},
{"t": 80.45, "e": 85.31, "text": "闇が生み出す苦しみだけは"},
{"t": 85.31, "e": 91.29, "text": "人の優しさ身に染みて"},
{"t": 92.34, "e": 95.8, "text": "また戦うのは何の為だ"},
{"t": 95.8, "e": 101.36, "text": "命の希望の為だろう"},
{"t": 101.36, "e": 105.06, "text": "そして未来に届かなくても"},
{"t": 105.06, "e": 109.58, "text": "せめて自分だけはまともで居たいと思う"},
{"t": 109.58, "e": 116.12, "text": "特に褒められもしない エハブミさん"},
{"t": 128.93, "e": 132.26, "text": "やがて時代が生まれるならば"},
{"t": 132.26, "e": 136.58, "text": "ここは自分だけでもまともで居たいと思う"},
{"t": 136.58, "e": 143.14, "text": "何でこんな事になった エハブミさん"},
{"t": 145.19, "e": 156.86, "text": "いつか繋いだ花を墓標に"}
]
