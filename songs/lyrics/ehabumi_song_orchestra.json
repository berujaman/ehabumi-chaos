[
{"t": 17.43, "e": 24.02, "text": "人から聞く話は 欠片で埋まる"},
{"t": 24.03, "e": 29.48, "text": "誤解したり 期待されたり"},
{"t": 29.49, "e": 33.57, "text": "悔しい時もあるけれど"},
{"t": 33.58, "e": 40.19, "text": "思い込みで 人を責めるぐらいなら"},
{"t": 40.2, "e": 45.59, "text": "真実求める 獣でありたい"},
{"t": 45.6, "e": 52.1, "text": "遥かに遠くまで 広がる言葉に"},
{"t": 52.11, "e": 60.8, "text": "少し前を照らすぐらいの希望を乗せよう"},
{"t": 60.81, "e": 67.07, "text": "僕の終わりは誰かの途中で"},
{"t": 67.08, "e": 71.89, "text": "僅かばかりの 優しさ学べば"},
{"t": 71.9, "e": 78.22, "text": "季節を知らせる 道の草花"},
{"t": 92.08, "e": 98.38, "text": "夢から覚め涙は 乾いて眠る"},
{"t": 98.39, "e": 103.25, "text": "人が増えて 友が減ったり"},
{"t": 103.26, "e": 107.46, "text": "寂しい時もあるけれど"},
{"t": 107.47, "e": 114.08, "text": "わだかまりで 熱を止めるぐらいなら"},
{"t": 114.09, "e": 119.69, "text": "叡智を求める 獣でありたい"},
{"t": 119.7, "e": 126.31, "text": "響きも違うよな 時代の言葉に"},
{"t": 126.32, "e": 135.27, "text": "少し笑って流離うぐらいの余裕を乗せよう"},
{"t": 135.28, "e": 141.5, "text": "僕の終わりは誰かの途中で"},
{"t": 141.51, "e": 147.0, "text": "しなるも折れぬ 強さを学べば"},
{"t": 147.01, "e": 152.83, "text": "節目を知らせる 水の鐘の音"},
{"t": 173.51, "e": 179.28, "text": "僕の終わりは誰かの途中で"},
{"t": 179.29, "e": 184.97, "text": "誰も知らない 誇りを重ねて"},
{"t": 184.98, "e": 191.62, "text": "夜明けを知らせる 幾度の太陽"}
]
