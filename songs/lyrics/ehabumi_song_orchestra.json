[
{"t": 17.64, "e": 23.76, "text": "人から聞く話は 欠片で埋まる"},
{"t": 23.76, "e": 27.3, "text": "誤解したり 期待されたり"},
{"t": 27.3, "e": 30.74, "text": "悔しい時もあるけれど"},
{"t": 30.74, "e": 36.96, "text": "思い込みで 人を責めるぐらいなら"},
{"t": 36.96, "e": 45.05, "text": "真実求める 獣でありたい"},
{"t": 45.05, "e": 51.27, "text": "遥かに遠くまで 広がる言葉に"},
{"t": 51.27, "e": 58.15, "text": "少し前を照らすぐらいの希望を乗せよう"},
{"t": 58.15, "e": 67.39, "text": "僕の終わりは誰かの途中で"},
{"t": 67.39, "e": 71.23, "text": "僅かばかりの 優しさ学べば"},
{"t": 71.23, "e": 78.19, "text": "季節を知らせる 道の草花"},
{"t": 92.09, "e": 98.21, "text": "夢から覚め涙は 乾いて眠る"},
{"t": 98.21, "e": 101.67, "text": "人が増えて 友が減ったり"},
{"t": 101.67, "e": 105.47, "text": "寂しい時もあるけれど"},
{"t": 105.47, "e": 111.92, "text": "わだかまりで 熱を止めるぐらいなら"},
{"t": 111.92, "e": 119.6, "text": "叡智を求める 獣でありたい"},
{"t": 119.6, "e": 125.68, "text": "響きも違うよな 時代の言葉に"},
{"t": 125.68, "e": 132.58, "text": "少し笑って流離うぐらいの余裕を乗せよう"},
{"t": 132.58, "e": 142.05, "text": "僕の終わりは誰かの途中で"},
{"t": 142.05, "e": 145.68, "text": "しなるも折れぬ 強さを学べば"},
{"t": 145.68, "e": 152.77, "text": "節目を知らせる 水の鐘の音"},
{"t": 173.51, "e": 179.64, "text": "僕の終わりは誰かの途中で"},
{"t": 179.64, "e": 183.56, "text": "誰も知らない 誇りを重ねて"},
{"t": 183.56, "e": 190.44, "text": "夜明けを知らせる 幾度の太陽"}
]
