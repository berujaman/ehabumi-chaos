[
{"t": 13.68, "e": 18.18, "text": "同じ大きさの 歯車だけじゃ"},
{"t": 18.19, "e": 23.32, "text": "強いトルクは 生まれない"},
{"t": 23.33, "e": 29.33, "text": "映画で見かけた 達人達は"},
{"t": 29.34, "e": 34.79, "text": "心の修行に 力を使った"},
{"t": 34.8, "e": 44.2, "text": "自分が主人公なら 『森羅万象』何を学ぶ"},
{"t": 44.21, "e": 50.11, "text": "あなたの 師匠は それを 諭した"},
{"t": 50.12, "e": 55.52, "text": "わたしの 師匠は それを 諭した"},
{"t": 55.53, "e": 61.18, "text": "この言葉は 同じ部品だ"},
{"t": 61.31, "e": 67.99, "text": "平和のための 喧嘩をしようぜ"},
{"t": 68.0, "e": 72.59, "text": "さぁ、いつでもかかってこい"},
{"t": 72.6, "e": 77.84, "text": "創造の 勝負を 始めよう"},
{"t": 82.27, "e": 88.71, "text": "今は本当に 争っているのか"},
{"t": 88.72, "e": 95.93, "text": "戦う気のない 演技の世界よ"},
{"t": 95.94, "e": 101.71, "text": "元をたどれば 猿とは言うが"},
{"t": 101.72, "e": 106.24, "text": "龍の罪を 蛇に問うか？"},
{"t": 106.25, "e": 113.14, "text": "子孫の恥じない それぞれの在り方へ"},
{"t": 113.15, "e": 118.47, "text": "あなたの 先祖は それを 守った"},
{"t": 118.48, "e": 123.79, "text": "わたしの 先祖は それを 守った"},
{"t": 123.8, "e": 129.35, "text": "先を進んで 我らはどうか？"},
{"t": 129.9, "e": 137.67, "text": "平和のための 喧嘩をしようぜ"},
{"t": 137.68, "e": 142.45, "text": "さぁ、 本気でかかってこい"},
{"t": 142.46, "e": 147.35, "text": "確かな 日常を 戦おう"},
{"t": 147.42, "e": 154.62, "text": "動乱がつないだ 螺旋のコイル"},
{"t": 154.63, "e": 160.02, "text": "どうだね 血が騒がないか？"},
{"t": 160.03, "e": 165.44, "text": "元は同じ 生物の血が"},
{"t": 171.13, "e": 178.01, "text": "卑怯な 愚者が 上に 居るなら"},
{"t": 178.02, "e": 185.1, "text": "実直な 愚者は 前に 居るから"},
{"t": 185.11, "e": 191.54, "text": "何を目指すか 自分で決めろ"},
{"t": 191.55, "e": 197.87, "text": "平和のための 喧嘩をしようぜ"},
{"t": 197.88, "e": 201.37, "text": "さぁ、自ら心を削れ"},
{"t": 201.38, "e": 206.68, "text": "磨いた 鏡面に 自分が映る"}
]
