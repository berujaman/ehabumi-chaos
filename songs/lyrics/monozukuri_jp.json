[
{"t": 13.94, "e": 18.94, "text": "同じ大きさの 歯車だけじゃ"},
{"t": 18.94, "e": 27.65, "text": "強いトルクは 生まれない"},
{"t": 27.65, "e": 32.52, "text": "映画で見かけた 達人達は"},
{"t": 32.52, "e": 39.29, "text": "心の修行に 力を使った"},
{"t": 39.29, "e": 46.56, "text": "自分が主人公なら 『森羅万象』何を学ぶ"},
{"t": 46.56, "e": 50.07, "text": "あなたの 師匠は それを 諭した"},
{"t": 50.07, "e": 53.5, "text": "わたしの 師匠は それを 諭した"},
{"t": 53.5, "e": 61.06, "text": "この言葉は 同じ部品だ"},
{"t": 61.48, "e": 67.55, "text": "平和のための 喧嘩をしようぜ"},
{"t": 67.55, "e": 71.14, "text": "さぁ、いつでもかかってこい"},
{"t": 71.14, "e": 77.82, "text": "創造の 勝負を 始めよう"},
{"t": 82.29, "e": 87.83, "text": "今は本当に 争っているのか"},
{"t": 87.83, "e": 95.47, "text": "戦う気のない 演技の世界よ"},
{"t": 95.47, "e": 101.99, "text": "元をたどれば 猿とは言うが"},
{"t": 101.99, "e": 108.23, "text": "龍の罪を 蛇に問うか？"},
{"t": 108.23, "e": 115.13, "text": "子孫の恥じない それぞれの在り方へ"},
{"t": 115.13, "e": 118.51, "text": "あなたの 先祖は それを 守った"},
{"t": 118.51, "e": 122.19, "text": "わたしの 先祖は それを 守った"},
{"t": 122.19, "e": 129.33, "text": "先を進んで 我らはどうか？"},
{"t": 130.19, "e": 136.6, "text": "平和のための 喧嘩をしようぜ"},
{"t": 136.6, "e": 139.72, "text": "さぁ、 本気でかかってこい"},
{"t": 139.72, "e": 146.85, "text": "確かな 日常を 戦おう"},
{"t": 147.42, "e": 152.31, "text": "動乱がつないだ 螺旋のコイル"},
{"t": 152.31, "e": 156.65, "text": "どうだね 血が騒がないか？"},
{"t": 156.65, "e": 165.37, "text": "元は同じ 生物の血が"},
{"t": 171.25, "e": 177.59, "text": "卑怯な 愚者が 上に 居るなら"},
{"t": 177.59, "e": 180.96, "text": "実直な 愚者は 前に 居るから"},
{"t": 180.96, "e": 184.94, "text": "何を目指すか 自分で決めろ"},
{"t": 184.94, "e": 190.98, "text": "平和のための 喧嘩をしようぜ"},
{"t": 190.98, "e": 194.78, "text": "さぁ、自ら心を削れ"},
{"t": 194.78, "e": 205.46, "text": "磨いた 鏡面に 自分が映る"}
]
