[
{"t": 19.11, "e": 21.7, "text": "只有同樣大小的 齒輪"},
{"t": 21.7, "e": 25.43, "text": "強大的扭矩 無法產生"},
{"t": 25.43, "e": 28.38, "text": "電影裡見過的 那些高手"},
{"t": 28.38, "e": 31.76, "text": "把力量用在 內心的修行上"},
{"t": 31.76, "e": 38.92, "text": "若自己就是主角 要從「森羅萬象」學些什麼？"},
{"t": 38.92, "e": 41.3, "text": "你的 師父 曾將此理 點明"},
{"t": 41.3, "e": 43.82, "text": "我的 師父 曾將此理 點明"},
{"t": 43.82, "e": 50.3, "text": "這些話語 就是相同的零件"},
{"t": 50.3, "e": 53.96, "text": "為了和平 來打一架吧"},
{"t": 53.96, "e": 57.16, "text": "來吧，隨時放馬過來"},
{"t": 57.16, "e": 68.0, "text": "創造性的 較量 現在開始吧"},
{"t": 71.4, "e": 73.98, "text": "此刻我們真的 在爭鬥嗎？"},
{"t": 73.98, "e": 77.48, "text": "毫無戰意的 演戲世界啊"},
{"t": 77.48, "e": 81.01, "text": "雖說追根溯源 我們都來自猿類"},
{"t": 81.01, "e": 84.35, "text": "龍犯下的罪 難道要向蛇追究嗎？"},
{"t": 84.35, "e": 91.23, "text": "不讓子孫蒙羞 各自活出自己的模樣"},
{"t": 91.23, "e": 94.35, "text": "你的 祖先 曾經 守護著它"},
{"t": 94.35, "e": 97.71, "text": "我的 祖先 曾經 守護著它"},
{"t": 97.71, "e": 106.26, "text": "如今繼續向前 我們又當如何？"},
{"t": 106.26, "e": 109.7, "text": "為了和平 來打一架吧"},
{"t": 109.7, "e": 113.14, "text": "來吧，拿出真本事放馬過來"},
{"t": 113.14, "e": 124.28, "text": "為了踏實的 日常 而戰吧"},
{"t": 137.52, "e": 140.15, "text": "動亂連接起的 螺旋線圈"},
{"t": 140.15, "e": 143.57, "text": "怎麼樣 難道不覺熱血沸騰嗎？"},
{"t": 143.57, "e": 151.57, "text": "本是同源的 生命之血啊"},
{"t": 151.57, "e": 155.12, "text": "卑鄙的 愚者 若身居 高位"},
{"t": 155.12, "e": 158.55, "text": "誠實的 愚者 便站在 前方"},
{"t": 158.55, "e": 167.1, "text": "要追求什麼 由你自己決定"},
{"t": 167.1, "e": 170.55, "text": "為了和平 來打一架吧"},
{"t": 170.55, "e": 173.88, "text": "來吧，親手磨礪自己的內心"},
{"t": 173.88, "e": 181.63, "text": "磨亮的 鏡面之中 映照出自己"}
]
