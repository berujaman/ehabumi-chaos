[
{"t": 18.9, "e": 22.92, "text": "只有同樣大小的 齒輪"},
{"t": 22.93, "e": 27.44, "text": "強大的扭矩 無法產生"},
{"t": 27.45, "e": 32.53, "text": "電影裡見過的 那些高手"},
{"t": 32.54, "e": 36.98, "text": "把力量用在 內心的修行上"},
{"t": 36.99, "e": 43.5, "text": "若自己就是主角 要從「森羅萬象」學些什麼？"},
{"t": 43.51, "e": 47.9, "text": "你的 師父 曾將此理 點明"},
{"t": 47.91, "e": 51.71, "text": "我的 師父 曾將此理 點明"},
{"t": 51.72, "e": 55.11, "text": "這些話語 就是相同的零件"},
{"t": 55.12, "e": 57.85, "text": "為了和平 來打一架吧"},
{"t": 57.86, "e": 60.61, "text": "來吧，隨時放馬過來"},
{"t": 60.62, "e": 68.02, "text": "創造性的 較量 現在開始吧"},
{"t": 71.25, "e": 75.62, "text": "此刻我們真的 在爭鬥嗎？"},
{"t": 75.63, "e": 80.26, "text": "毫無戰意的 演戲世界啊"},
{"t": 80.27, "e": 86.62, "text": "雖說追根溯源 我們都來自猿類"},
{"t": 86.63, "e": 91.86, "text": "龍犯下的罪 難道要向蛇追究嗎？"},
{"t": 91.87, "e": 98.44, "text": "不讓子孫蒙羞 各自活出自己的模樣"},
{"t": 98.45, "e": 102.64, "text": "你的 祖先 曾經 守護著它"},
{"t": 102.65, "e": 107.45, "text": "我的 祖先 曾經 守護著它"},
{"t": 107.46, "e": 112.58, "text": "如今繼續向前 我們又當如何？"},
{"t": 112.59, "e": 116.3, "text": "為了和平 來打一架吧"},
{"t": 116.31, "e": 124.31, "text": "來吧，拿出真本事放馬過來"},
{"t": 137.51, "e": 141.95, "text": "為了踏實的 日常 而戰吧"},
{"t": 141.96, "e": 146.71, "text": "動亂連接起的 螺旋線圈"},
{"t": 146.72, "e": 152.31, "text": "怎麼樣 難道不覺熱血沸騰嗎？"},
{"t": 152.32, "e": 156.08, "text": "本是同源的 生命之血啊"},
{"t": 156.09, "e": 160.1, "text": "卑鄙的 愚者 若身居 高位"},
{"t": 160.11, "e": 162.84, "text": "誠實的 愚者 便站在 前方"},
{"t": 162.85, "e": 168.29, "text": "要追求什麼 由你自己決定"},
{"t": 168.3, "e": 172.34, "text": "為了和平 來打一架吧"},
{"t": 172.35, "e": 177.16, "text": "來吧，親手磨礪自己的內心"},
{"t": 177.17, "e": 182.03, "text": "磨亮的 鏡面之中 映照出自己"}
]
