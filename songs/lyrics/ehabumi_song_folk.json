[
{"t": 14.42, "e": 20.49, "text": "人から聞く話は 欠片で埋まる"},
{"t": 21.38, "e": 24.43, "text": "誤解したり 期待されたり"},
{"t": 24.43, "e": 28.47, "text": "悔しい時もあるけれど"},
{"t": 28.47, "e": 33.63, "text": "思い込みで 人を責めるぐらいなら"},
{"t": 33.63, "e": 41.86, "text": "真実求める 獣でありたい"},
{"t": 42.7, "e": 48.66, "text": "遥かに遠くまで 広がる言葉に"},
{"t": 49.14, "e": 57.97, "text": "少し前を照らすぐらいの希望を乗せよう"},
{"t": 58.51, "e": 65.03, "text": "僕の終わりは誰かの途中で"},
{"t": 65.57, "e": 69.0, "text": "僅かばかりの 優しさ学べば"},
{"t": 69.0, "e": 73.72, "text": "季節を知らせる 道の草花"},
{"t": 92.05, "e": 98.14, "text": "夢から覚め涙は 乾いて眠る"},
{"t": 99.05, "e": 102.08, "text": "人が増えて 友が減ったり"},
{"t": 102.08, "e": 105.52, "text": "寂しい時もあるけれど"},
{"t": 105.52, "e": 112.44, "text": "わだかまりで 熱を止めるぐらいなら"},
{"t": 112.44, "e": 119.23, "text": "叡智を求める 獣でありたい"},
{"t": 120.3, "e": 126.46, "text": "響きも違うよな 時代の言葉に"},
{"t": 126.78, "e": 135.21, "text": "少し笑って流離うぐらいの余裕を乗せよう"},
{"t": 136.16, "e": 142.51, "text": "僕の終わりは誰かの途中で"},
{"t": 143.15, "e": 146.56, "text": "しなるも折れぬ 強さを学べば"},
{"t": 146.56, "e": 151.59, "text": "節目を知らせる 水の鐘の音"},
{"t": 153.82, "e": 160.07, "text": "僕の終わりは誰かの途中で"},
{"t": 160.96, "e": 164.05, "text": "誰も知らない 誇りを重ねて"},
{"t": 164.05, "e": 169.2, "text": "夜明けを知らせる 幾度の太陽"}
]
