[
{"t": 14.41, "e": 20.42, "text": "人から聞く話は 欠片で埋まる"},
{"t": 21.37, "e": 28.43, "text": "誤解したり 期待されたり"},
{"t": 28.46, "e": 32.0, "text": "悔しい時もあるけれど"},
{"t": 32.03, "e": 38.19, "text": "思い込みで 人を責めるぐらいなら"},
{"t": 38.21, "e": 41.89, "text": "真実求める 獣でありたい"},
{"t": 42.69, "e": 49.03, "text": "遥かに遠くまで 広がる言葉に"},
{"t": 49.13, "e": 57.99, "text": "少し前を照らすぐらいの希望を乗せよう"},
{"t": 58.13, "e": 65.04, "text": "僕の終わりは誰かの途中で"},
{"t": 65.56, "e": 69.44, "text": "僅かばかりの 優しさ学べば"},
{"t": 69.45, "e": 73.74, "text": "季節を知らせる 道の草花"},
{"t": 92.03, "e": 98.06, "text": "夢から覚め涙は 乾いて眠る"},
{"t": 99.04, "e": 104.49, "text": "人が増えて 友が減ったり"},
{"t": 104.5, "e": 108.31, "text": "寂しい時もあるけれど"},
{"t": 108.32, "e": 113.98, "text": "わだかまりで 熱を止めるぐらいなら"},
{"t": 114.0, "e": 119.09, "text": "叡智を求める 獣でありたい"},
{"t": 119.94, "e": 126.48, "text": "響きも違うよな 時代の言葉に"},
{"t": 126.77, "e": 135.24, "text": "少し笑って流離うぐらいの余裕を乗せよう"},
{"t": 136.17, "e": 142.6, "text": "僕の終わりは誰かの途中で"},
{"t": 143.15, "e": 147.2, "text": "しなるも折れぬ 強さを学べば"},
{"t": 147.21, "e": 151.62, "text": "節目を知らせる 水の鐘の音"},
{"t": 153.82, "e": 160.02, "text": "僕の終わりは誰かの途中で"},
{"t": 160.95, "e": 164.94, "text": "誰も知らない 誇りを重ねて"},
{"t": 164.95, "e": 169.22, "text": "夜明けを知らせる 幾度の太陽"}
]
