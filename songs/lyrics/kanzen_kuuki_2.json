[
{"t": 3.69, "e": 10.1, "text": "何かを知ってしまったことで"},
{"t": 10.11, "e": 15.95, "text": "失うこともあるとは知るが"},
{"t": 15.96, "e": 22.37, "text": "光が生み出す創造だけは"},
{"t": 22.38, "e": 27.98, "text": "歩む孤独にあふれて"},
{"t": 27.99, "e": 33.69, "text": "今戦うのは何の為だ"},
{"t": 33.7, "e": 39.68, "text": "まだ見ぬ世界の為だろう"},
{"t": 47.09, "e": 54.56, "text": "どうせ全てが壊れるならば"},
{"t": 54.57, "e": 66.77, "text": "せめて自分だけはまともで居たいと思う"},
{"t": 66.78, "e": 75.08, "text": "誰も知らない存在 エハブミさん"},
{"t": 80.9, "e": 87.67, "text": "何かを知らずに進んだことを"},
{"t": 87.68, "e": 94.86, "text": "後悔する日もあるとは知るが"},
{"t": 94.87, "e": 101.34, "text": "闇が生み出す苦しみだけは"},
{"t": 101.35, "e": 107.37, "text": "人の優しさ身に染みて"},
{"t": 107.62, "e": 112.61, "text": "また戦うのは何の為だ"},
{"t": 112.62, "e": 117.55, "text": "命の希望の為だろう"},
{"t": 123.8, "e": 131.15, "text": "そして未来に届かなくても"},
{"t": 131.16, "e": 141.71, "text": "せめて自分だけはまともで居たいと思う"},
{"t": 141.72, "e": 151.19, "text": "特に褒められもしない エハブミさん"},
{"t": 151.2, "e": 157.46, "text": "やがて時代が生まれるならば"},
{"t": 157.47, "e": 165.81, "text": "ここは自分だけでもまともで居たいと思う"},
{"t": 165.82, "e": 174.07, "text": "何でこんな事になった エハブミさん"},
{"t": 174.08, "e": 182.02, "text": "いつか繋いだ花を墓標に"}
