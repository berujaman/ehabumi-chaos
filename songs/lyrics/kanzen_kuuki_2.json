[
{"t": 3.76, "e": 9.3, "text": "何かを知ってしまったことで"},
{"t": 9.3, "e": 16.39, "text": "失うこともあるとは知るが"},
{"t": 16.39, "e": 23.06, "text": "光が生み出す創造だけは"},
{"t": 23.06, "e": 28.34, "text": "歩む孤独にあふれて"},
{"t": 28.34, "e": 34.08, "text": "今戦うのは何の為だ"},
{"t": 34.08, "e": 39.57, "text": "まだ見ぬ世界の為だろう"},
{"t": 47.09, "e": 52.77, "text": "どうせ全てが壊れるならば"},
{"t": 52.77, "e": 59.46, "text": "せめて自分だけはまともで居たいと思う"},
{"t": 59.46, "e": 75.05, "text": "誰も知らない存在 エハブミさん"},
{"t": 80.92, "e": 86.56, "text": "何かを知らずに進んだことを"},
{"t": 86.56, "e": 93.38, "text": "後悔する日もあるとは知るが"},
{"t": 93.38, "e": 100.08, "text": "闇が生み出す苦しみだけは"},
{"t": 100.08, "e": 107.04, "text": "人の優しさ身に染みて"},
{"t": 107.04, "e": 111.16, "text": "また戦うのは何の為だ"},
{"t": 111.16, "e": 117.53, "text": "命の希望の為だろう"},
{"t": 123.81, "e": 129.58, "text": "そして未来に届かなくても"},
{"t": 129.58, "e": 136.36, "text": "せめて自分だけはまともで居たいと思う"},
{"t": 136.36, "e": 151.03, "text": "特に褒められもしない エハブミさん"},
{"t": 151.03, "e": 156.94, "text": "やがて時代が生まれるならば"},
{"t": 156.94, "e": 163.63, "text": "ここは自分だけでもまともで居たいと思う"},
{"t": 163.63, "e": 170.58, "text": "何でこんな事になった エハブミさん"},
{"t": 170.58, "e": 179.58, "text": "いつか繋いだ花を墓標に"}
