[
{"t": 5.07, "e": 6.23, "text": "おはようございます。"},
{"t": 8.79, "e": 16.87, "text": "困りごとに真面目に取り組むのは"},
{"t": 16.94, "e": 21.01, "text": "自分も困った歴史があるから"},
{"t": 21.02, "e": 24.1, "text": "スタートからのクライマー"},
{"t": 24.86, "e": 27.59, "text": "自転車操業 上り坂"},
{"t": 27.6, "e": 30.71, "text": "止まる気持ちは置いてきた"},
{"t": 30.79, "e": 35.28, "text": "答えはいつも一つではなくて"},
{"t": 35.29, "e": 38.97, "text": "その時一つに絞っただけ"},
{"t": 38.98, "e": 41.44, "text": "考えるから足が動く"},
{"t": 49.16, "e": 53.0, "text": "いつもの ライフワークノルマ"},
{"t": 53.08, "e": 57.3, "text": "解決に向かう道があるのは"},
{"t": 58.02, "e": 63.08, "text": "自分も悩んだ歴史があるから"},
{"t": 63.11, "e": 64.8, "text": "勝手を知ってスプリント"},
{"t": 65.42, "e": 68.42, "text": "自転車操業 下り坂"},
{"t": 68.43, "e": 72.16, "text": "時代が追い付く先を行け"},
{"t": 72.17, "e": 75.84, "text": "正解はまた一つではなくて"},
{"t": 75.85, "e": 78.77, "text": "その時一つを選んだだけ"},
{"t": 78.8, "e": 80.69, "text": "考えずとも心は動く"},
{"t": 80.7, "e": 83.51, "text": "いつもの ライフワークノルマ"},
{"t": 83.59, "e": 87.64, "text": "人生いつでも浮き沈み"},
{"t": 87.68, "e": 91.88, "text": "自転車操業 道となり"},
{"t": 91.93, "e": 96.33, "text": "道を作って後を引け"},
{"t": 101.96, "e": 106.31, "text": "失敗いつも無駄ではなくて"},
{"t": 106.32, "e": 110.58, "text": "今日の力は過去の汗から"},
{"t": 110.59, "e": 114.49, "text": "考えたから未来が動く"},
{"t": 114.5, "e": 118.41, "text": "いつもの ライフワークノルマ"},
{"t": 120.24, "e": 122.58, "text": "おつかれさまでした。"}
]
