[
{"t": 4.76, "e": 6.21, "text": "おはようございます。"},
{"t": 8.78, "e": 11.86, "text": "困りごとに真面目に取り組むのは"},
{"t": 11.86, "e": 17.0, "text": "自分も困った歴史があるから"},
{"t": 17.0, "e": 19.05, "text": "スタートからのクライマー"},
{"t": 19.05, "e": 21.0, "text": "自転車操業 上り坂"},
{"t": 21.0, "e": 24.09, "text": "止まる気持ちは置いてきた"},
{"t": 25.19, "e": 29.01, "text": "答えはいつも一つではなくて"},
{"t": 29.01, "e": 32.99, "text": "その時一つに絞っただけ"},
{"t": 32.99, "e": 37.67, "text": "考えるから足が動く"},
{"t": 37.67, "e": 41.43, "text": "いつもの ライフワークノルマ"},
{"t": 49.47, "e": 53.08, "text": "解決に向かう道があるのは"},
{"t": 53.08, "e": 57.27, "text": "自分も悩んだ歴史があるから"},
{"t": 58.03, "e": 59.68, "text": "勝手を知ってスプリント"},
{"t": 59.68, "e": 61.84, "text": "自転車操業 下り坂"},
{"t": 61.84, "e": 64.77, "text": "時代が追い付く先を行け"},
{"t": 65.47, "e": 69.56, "text": "正解はまた一つではなくて"},
{"t": 69.56, "e": 74.31, "text": "その時一つを選んだだけ"},
{"t": 74.31, "e": 78.27, "text": "考えずとも心は動く"},
{"t": 78.27, "e": 82.08, "text": "いつもの ライフワークノルマ"},
{"t": 83.59, "e": 87.11, "text": "人生いつでも浮き沈み"},
{"t": 87.11, "e": 91.93, "text": "自転車操業 道となり"},
{"t": 91.93, "e": 96.28, "text": "道を作って後を引け"},
{"t": 101.96, "e": 106.08, "text": "失敗いつも無駄ではなくて"},
{"t": 106.08, "e": 110.62, "text": "今日の力は過去の汗から"},
{"t": 110.62, "e": 114.65, "text": "考えたから未来が動く"},
{"t": 114.65, "e": 118.39, "text": "いつもの ライフワークノルマ"},
{"t": 120.25, "e": 122.56, "text": "おつかれさまでした。"}
]
